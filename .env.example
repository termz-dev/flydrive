# Names and descriptions only. Never commit real values.

# Deployment environment: local | ci | staging | production
APP_ENV=local

# Public base URL of the site, used for canonical links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Public contact email. Leave unset until the founders approve a published address;
# the contact page then says contact details are not yet published.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional. Public contact phone/WhatsApp number in international format. Same rule as above.
NEXT_PUBLIC_CONTACT_PHONE=

# Log level: debug | info | warn | error
LOG_LEVEL=info
