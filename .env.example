# Names and descriptions only. Never commit real values. Copy to .env.local for development.

# Deployment environment: local | ci | staging | production
APP_ENV=local

# Public base URL of the site (used for metadata and the Paystack callback URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "true" opens customer sign-up, booking requests and driver applications. Build-time.
# Leave "false" on the live site until launch; set "true" locally to use the product.
NEXT_PUBLIC_BOOKINGS_OPEN=false

# Optional public contact details. Leave empty until approved.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# PostgreSQL. Local: postgres://postgres:postgres@localhost:5432/flydrive
# Vercel + Supabase: the "Transaction pooler" URI (port 6543) from Supabase → Connect.
DATABASE_URL=

# Only for `pnpm test:db`: a disposable database whose name contains "test".
DATABASE_URL_TEST=

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts staff authenticator secrets. Changing it locks staff out of MFA (re-enrol needed).
APP_ENCRYPTION_KEY=

# Paystack secret key (sk_test_... locally, sk_live_... in production). Webhook URL to set in
# Paystack: https://YOUR-DOMAIN/api/webhooks/paystack
PAYSTACK_SECRET_KEY=

# Random string (16+ chars). Vercel Cron sends it to /api/cron/tick. Set the same value in Vercel.
CRON_SECRET=

# Log level: debug | info | warn | error
LOG_LEVEL=info
